{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "member.schema.json",
  "title": "สมาชิก",
  "type": "object",
  "required": ["id", "type", "name", "joined"],
  "properties": {
    "id": { "type": "string", "pattern": "^S\\d{3,}$" },
    "type": { "const": "members" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "nick": { "type": "string", "maxLength": 60 },
    "phone": { "type": "string", "maxLength": 16 },
    "born": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "joined": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "addr": { "type": "string" },
    "bookno": { "type": "string" },
    "monthly": { "type": "number", "minimum": 1, "maximum": 10000 },
    "status": { "enum": ["active", "resigned"] },
    "resignedAt": { "type": "string" },
    "note": { "type": "string" },
    "updatedAt": { "type": "string" },
    "deletedAt": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
