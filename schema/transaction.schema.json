{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "transaction.schema.json",
  "title": "รายการเดินบัญชี (เงินสดเข้า/ออก)",
  "type": "object",
  "required": ["id", "type", "kind", "amount", "at"],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "type": { "const": "txs" },
    "kind": { "enum": ["saja", "sharebuy", "annualsave", "fine", "welfare_in", "welfare_out", "loan_out", "loan_repay", "dividend_pay", "other_in", "other_out"] },
    "member": { "type": "string", "pattern": "^S\\d{3}$" },
    "memberName": { "type": "string" },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "n": { "type": "integer", "minimum": 1 },
    "nights": { "type": "integer", "minimum": 1, "maximum": 60 },
    "fee": { "type": "number", "minimum": 0 },
    "principal": { "type": "number", "minimum": 0 },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "ym": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "fineYM": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cat": { "type": "string" },
    "title": { "type": "string" },
    "loanId": { "type": "string", "pattern": "^L\\d{3}$" },
    "received": { "type": "boolean" },
    "overQuota": { "type": "boolean" },
    "note": { "type": "string", "maxLength": 300 },
    "updatedAt": { "type": "string" },
    "deletedAt": { "type": ["string", "null"] },
    "deleteReason": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
